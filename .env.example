# Copy to .env and fill in real values. Never commit .env.

# Gitea API token used by tooling/CI for issue creation, etc.
# Generate from your Gitea user settings: Applications > Generate New Token.
GITEA_BASE_URL=https://git.example.com
GITEA_OWNER=your-user
GITEA_REPO=dooray-widget
GITEA_TOKEN=

# Dooray tenant URL and personal API token (Settings > API).
DOORAY_URL=https://your-domain.dooray.com/
DOORAY_API_KEY=
# Optional: override API base (default https://api.dooray.com)
# DOORAY_API_BASE=https://api.dooray.com

# Firebase Hosting deploy (npm run site:deploy): Google account that owns the project; project defaults to desk-widgets-chilgong88.
FIREBASE_ACCOUNT=
# FIREBASE_PROJECT=

# Polling interval in seconds (30-60 recommended)
POLL_INTERVAL_SEC=45

# Google sign-in of the calendar widget (#114): OAuth client of type "Desktop app" (docs/google-oauth-setup.md).
# Written into widgets/calendar/google-client.json (git-ignored) when the widget is built. Leave empty to build without it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_PW=
